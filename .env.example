# Copy to .env for local overrides
# Example: https://domain.com
SITE_URL=

# Salted scrypt hash in the format:
# scrypt$<salt>$<hex>
# Example generation:
# The dollar signs must be escaped in .env files so Next.js does not expand them.
# node -e 'const { randomBytes, scryptSync } = require("crypto"); const password = process.argv[1]; const salt = randomBytes(16).toString("hex"); const hash = scryptSync(password, salt, 64).toString("hex"); console.log("scrypt\\$" + salt + "\\$" + hash);' "your-password"
ADMIN_PASSWORD_HASH=

# Random secret used to sign the admin session cookie.
# Example generation:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Optional override for the SQLite database file path.
# Local default: data/shows.sqlite
SHOWS_DB_PATH=
